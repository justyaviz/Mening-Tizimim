# Railway PostgreSQL
# Railway app service ichida Postgres service variable'ini reference qiling.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Odatda kerak emas. Public Postgres endpoint SSL talab qilsa true qiling.
DATABASE_SSL=false

# Bitta database ichida boshqa workspace kerak bo‘lsa o‘zgartiring.
WORKSPACE_KEY=main
